# keys.ini.template — the committed shape of keys.ini.
# Setup: copy to keys.ini (gitignored) and fill in real values.
# Read with python's configparser; empty value = that backend is off.

[brave]
# brave.com/search/api — take the SEARCH plan, NOT Answers (see PLAN.md,
# "Two traps"). Free tier: $5 credit/month ≈ 1,000 queries.
api_key =
# Two-letter country code (e.g. no). Biases results toward local retail/
# news and tells the decompose step to write local-language queries when
# availability or prices matter — US-only retrieval confidently missed
# Norwegian resellers in the first face-off round.
country =

[ollama_cloud]
# Dev harness only — the shipped default stays local (PLAN.md "Dev
# harness"). On a box running the Ollama daemon, http://localhost:11434/v1
# works key-less (the daemon proxies cloud models) — but note NoLlama also
# claims 11434 when running, so the direct URL is immune to port fights.
# Avoid heavy thinking models: reasoning shares max_tokens and qwen3.5:397b
# exhausts 8k tokens thinking before writing a word of answer.
base_url = https://ollama.com/v1
api_key =
model = mistral-large-3:675b
decompose_model = gemma4:31b

# --- Borrowed readers (PLAN.md item 4) — fill in as they get wired up.
# Sections may use `key =` or `api_key =`; empty = off.

[openrouter]
key =

[deepseek]
key =

[openai]
key =

[anthropic]
key =

[nollama]
# Local NoLlama server (OpenAI-compatible). No key — it's our own box.
base_url = http://localhost:18000/v1

[searxng]
# Parallel corroborator. Self-hosted, $0 marginal:
#   docker run -d --name searxng --restart unless-stopped -p 8888:8080 \
#     -v <repo>/searxng:/etc/searxng searxng/searxng
# The mounted settings.yml enables format=json (403 without it).
base_url = http://localhost:8888
